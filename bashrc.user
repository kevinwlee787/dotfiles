#!/usr/bin/env bash
# User bash configuration.
#
# Sourced by a managed ~/.bashrc, after it sets its default PS1,
# so anything set here wins. Do not move this into ~/.bash_profile.user:
# that is sourced before ~/.bashrc, and the default PS1 would overwrite it.

export LANG=en_US.utf-8
export LC_ALL="$LANG"
export EDITOR=nvim

# Free up Ctrl-S/Ctrl-Q. Guarded because stty needs a tty, and sshd sources this
# file for non-interactive commands.
if [[ $- == *i* ]]; then
    stty -ixoff
    stty -ixon
fi

alias tmux='TERM=xterm-256color tmux'

# Refresh tmux environment variables in current shell
function tmup() {
    echo -n "Updating to latest tmux environment...";
    export IFS=",";
    for line in $(tmux showenv -t $(tmux display -p "#S") | tr "\n" ",");
    do
        if [[ $line == -* ]]; then
            unset $(echo $line | cut -c2-);
        else
            export "$line";
        fi;
    done;
    unset IFS;
    echo "Done"
}

# Show version control state in the prompt.
# The backslash in \$(bpvcs_bash_prompt) is required: it defers the call to
# each prompt render instead of running it once, here.
if [[ -r "${HOME}/bash-prompt-vcs.bash" ]]; then
    # shellcheck source=/dev/null
    source "${HOME}/bash-prompt-vcs.bash"
    PS1="\u@\h:\w\$(bpvcs_bash_prompt)\$ "
fi

# fzf key bindings and completion:
#   Ctrl-R  fuzzy search command history
#   Ctrl-T  insert a file path at the cursor
#   Alt-C   cd into a subdirectory
# Generated by fzf itself, so it stays correct across fzf upgrades.
if command -v fzf >/dev/null 2>&1; then
    eval "$(fzf --bash)"
fi

# Machine-specific additions (internal tooling, per-site paths).
if [[ -r "${HOME}/.bashrc.user.local" ]]; then
    # shellcheck source=/dev/null
    source "${HOME}/.bashrc.user.local"
fi

# Bazel shorthands. A bare `...` is relative to $PWD, so `bb` with no arguments
# builds everything at or below the current directory.
alias bz='bazel'
alias br='bazel run'
bb() { bazel build "${@:-...}"; }
bt() { bazel test "${@:-...}"; }

# Flush history after every command. Bash otherwise only writes it on a clean
# exit, so a killed terminal multiplexer or container takes every window's
# history with it.
PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; ${PROMPT_COMMAND}}"
